# Firebase web config (Firebase console > Project settings > Your apps > Web app). Not secrets, but kept out of git.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# App Check: reCAPTCHA v3 site key for the hosted app. For local runs set APPCHECK_DEBUG=1 instead.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_APPCHECK_DEBUG=
# Server only (payment rail, later): Open Payments keys and APP_SECRET. Never commit.
APP_SECRET=
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE=
# Server only. The Firebase service account JSON on one line (Vercel env var; never commit it).
FIREBASE_SERVICE_ACCOUNT=
# Server-side spending limit per voice payment, in kobo (default 5000000 = 50,000 naira).
VOICE_LIMIT_MINOR=
# Local tests only: point sign-in at the Auth emulator, e.g. http://127.0.0.1:9099
NEXT_PUBLIC_AUTH_EMULATOR=
# Real Open Payments test-wallet rail (server only; when all six are set the app uses it, otherwise it stays SIMULATED).
RECEIVER_WALLET_ADDRESS_URL=
RECEIVER_KEY_ID=
RECEIVER_PRIVATE_KEY=
PAYER_WALLET_ADDRESS_URL=
PAYER_KEY_ID=
PAYER_PRIVATE_KEY=
# Weekly spending cap asked for at wallet connection, in minor units of the payer wallet asset (default 5000 = $50.00).
WEEKLY_CAP_MINOR=
# App Check is enforced unless this is 0 (use 0 only for local dev). Production keeps 1.
APPCHECK_ENFORCE=1
# Optional. Comma-separated allowed app origins for passkey RP ID and wallet redirect (default: usepayalone.tech, pay-alone-hybrid.vercel.app, localhost:3000).
# APP_ORIGINS=
