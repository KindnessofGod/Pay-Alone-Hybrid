rules_version = '2';
// Browsers never read or write Firestore directly. Every document (PINs, pending payments,
// challenges, receipts) is written and read only by our server through the Admin SDK,
// which these rules do not apply to. So the rules deny everything.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
